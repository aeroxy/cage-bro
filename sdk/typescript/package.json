{
  "name": "@cage-bro/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for cage-bro sandbox",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "bun build:js && bun build:types",
    "build:js": "bun build src/index.ts --outdir dist --target node --format cjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "npm run build"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
